# Copy to .env and fill in. Never commit .env.
APP_ENV=production                 # production refuses to start with demo secrets
SECRET_KEY=                        # 32+ random chars:  python -c "import secrets;print(secrets.token_urlsafe(48))"
DEVICE_KEY=                        # 16+ random chars, used by cameras / AI services (header X-Device-Key)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=                    # 10+ chars, required in production
CORS_ORIGINS=http://localhost:5173 # comma separated list of allowed frontend origins
POSTGRES_USER=elderlife
POSTGRES_PASSWORD=                 # required by docker-compose
POSTGRES_DB=elderlife
# DATABASE_URL=postgresql://elderlife:PASSWORD@db:5432/elderlife   (compose builds it for you)
EXPORT_KEY=                        # optional, 16+ chars: read-only key for Power BI scheduled refresh (header X-Export-Key)
ESCALATION_STEP_SECONDS=300
VERIFY_SECONDS=60
FALL_MIN_CONFIDENCE=0.6
ACK_SNOOZE_MINUTES=30
ML_MODE=auto
DEFAULT_LANG=en
TELEGRAM_BOT_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
VITE_API=http://localhost:8000
